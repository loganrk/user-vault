# Database
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=secret
DB_NAME=user_vault
DB_PREFIX=

# Kafka (set KAFKA_ENABLED=true to connect; if false a no-op notifier is used)
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=user-vault
KAFKA_VERSION=2.1.0
KAFKA_RETRY_MAX=3

# Cipher (set CIPHER_SECRET_ENCRYPTION_ENABLED=true to decrypt broker/db credentials at runtime)
CIPHER_SECRET_ENCRYPTION_ENABLED=false
CIPHER_SECRET_KEY=
